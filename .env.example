# ============================================================
# DIMITENT — Ρυθμίσεις αποστολής email της φόρμας επικοινωνίας
# ------------------------------------------------------------
# ΜΗΝ βάλετε τον κωδικό σε αυτό το αρχείο και ΜΗΝ τον ανεβάσετε
# στο Git. Οι τιμές μπαίνουν στο Vercel:
#   Project → Settings → Environment Variables
#
# ΥΠΟΧΡΕΩΤΙΚΟ είναι μόνο το SMTP_PASS. Τα υπόλοιπα έχουν ήδη
# προεπιλογή μέσα στο api/contact.js και μπαίνουν εδώ μόνο αν
# χρειαστεί να αλλάξουν.
# ============================================================

# App Password του λογαριασμού dimitriadismousamas@gmail.com.
# ΔΕΝ είναι ο κανονικός κωδικός του Gmail — είναι ξεχωριστός κωδικός
# 16 χαρακτήρων που φτιάχνεται στο myaccount.google.com/apppasswords
# (χρειάζεται ενεργό 2-Step Verification). Η Google τον δείχνει σε
# 4άδες με κενά· τα κενά αφαιρούνται αυτόματα από τον κώδικα.
SMTP_PASS=

# --- Προαιρετικά (προεπιλογές του κώδικα) -------------------

# Ο SMTP server της Google
# SMTP_HOST=smtp.gmail.com

# 465 = SSL (προεπιλογή) | 587 = STARTTLS
# SMTP_PORT=465

# Ο λογαριασμός από τον οποίο γίνεται η αυθεντικοποίηση.
# Στο Gmail το "From" πρέπει να είναι αυτός ο λογαριασμός.
# SMTP_USER=dimitriadismousamas@gmail.com

# Πού παραδίδονται τα αιτήματα (αν λείπει, πάει στο SMTP_USER)
# MAIL_TO=dimitriadismousamas@gmail.com
