# ============================================================
# DIMITENT — Ρυθμίσεις αποστολής email της φόρμας επικοινωνίας
# ------------------------------------------------------------
# ΜΗΝ βάλετε τον κωδικό σε αυτό το αρχείο και ΜΗΝ τον ανεβάσετε
# στο Git. Οι τιμές μπαίνουν στο Vercel:
#   Project → Settings → Environment Variables
# ============================================================

# Ο mail server του domain (επιβεβαιωμένο: ανοιχτό σε 465 και 587)
SMTP_HOST=mail.dimitent.gr

# 465 = SSL (προτεινόμενο) | 587 = STARTTLS
SMTP_PORT=465

# Το mailbox από το οποίο γίνεται η αυθεντικοποίηση
SMTP_USER=info@dimitent.gr

# Ο κωδικός του mailbox — μόνο στο Vercel, ποτέ στον κώδικα
SMTP_PASS=

# Πού παραδίδονται τα αιτήματα (αν λείπει, πάει στο SMTP_USER)
MAIL_TO=info@dimitent.gr
